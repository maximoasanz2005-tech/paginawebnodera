# Variables de entorno del frontend (Vite).
# Estas son públicas y se incluyen en el bundle. NO pongas secretos acá.

# URL y clave pública anónima de Supabase (ya configuradas en .env)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────
# Secrets del servidor (NO van en .env del frontend).
# Se configuran en el panel de Supabase → Edge Functions → Secrets.
# ─────────────────────────────────────────────

# RESEND_API_KEY       → API key de Resend (https://resend.com)
# CONTACT_RECIPIENT    → correo destino (noderaservicios@gmail.com)
# CONTACT_FROM_EMAIL   → correo remitente verificado en Resend
#                        (si no tenés dominio propio, podés usar
#                         onboarding@resend.dev para pruebas)
